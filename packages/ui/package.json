{
  "name": "@rakit-ui/ui",
  "version": "1.0.0",
  "description": "Rakit UI — React component library built on Tailwind CSS",
  "license": "MIT",
  "author": "Abduh Ichsan <abduhikhsan1@gmail.com>",
  "homepage": "https://github.com/MAbduhI/rakit-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MAbduhI/rakit-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/MAbduhI/rakit-ui/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "tailwindcss",
    "design-system",
    "component-library"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./maps": {
      "types": "./dist/maps.d.ts",
      "import": "./dist/maps.js",
      "require": "./dist/maps.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "icons": "node scripts/generate-icon-names.mjs",
    "icons:check": "node scripts/generate-icon-names.mjs --check",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0",
    "leaflet.gridlayer.googlemutant": "^0.16.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "leaflet": "^1.9.4",
    "leaflet.gridlayer.googlemutant": "^0.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^9.0.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "leaflet.gridlayer.googlemutant": {
      "optional": true
    }
  }
}
