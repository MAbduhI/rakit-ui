{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "extends": ["./biome.jsonc"],
  "linter": {
    "rules": {
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/tests/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/vitest.config.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          },
          "suspicious": {
            "noImportCycles": "off"
          }
        }
      }
    }
  ]
}
